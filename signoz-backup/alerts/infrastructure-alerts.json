{
  "apiVersion": "signoz.io/v1alpha1",
  "kind": "AlertRules",
  "metadata": {
    "name": "infrastructure-alerts"
  },
  "spec": {
    "alerts": [
      {
        "name": "HighCPUUsage",
        "description": "Alert when CPU usage exceeds 80% for 5 minutes",
        "expr": "rate(process.cpu.time{host_name!=\"\"}[5m]) * 100 > 80",
        "for": "5m",
        "severity": "warning",
        "labels": {
          "team": "infrastructure",
          "service": "bots"
        },
        "annotations": {
          "summary": "High CPU usage detected",
          "description": "CPU usage is above 80% for more than 5 minutes on {{ $labels.host_name }}"
        }
      },
      {
        "name": "HighMemoryUsage",
        "description": "Alert when memory usage exceeds 10GB",
        "expr": "process.memory.usage{host_name!=\"\"} > 10000000000",
        "for": "5m",
        "severity": "critical",
        "labels": {
          "team": "infrastructure",
          "service": "bots"
        },
        "annotations": {
          "summary": "High memory usage detected",
          "description": "Memory usage is above 10GB on {{ $labels.host_name }}"
        }
      },
      {
        "name": "ContainerHighCPU",
        "description": "Alert when container CPU exceeds 70%",
        "expr": "rate(container_cpu_usage_seconds_total{container_name!=\"\"}[5m]) * 100 > 70",
        "for": "5m",
        "severity": "warning",
        "labels": {
          "team": "infrastructure",
          "service": "containers"
        },
        "annotations": {
          "summary": "Container CPU usage high",
          "description": "Container {{ $labels.container_name }} CPU usage is above 70%"
        }
      },
      {
        "name": "ContainerHighMemory",
        "description": "Alert when container memory exceeds 1GB",
        "expr": "container_memory_usage_total{container_name!=\"\"} > 1000000000",
        "for": "5m",
        "severity": "warning",
        "labels": {
          "team": "infrastructure",
          "service": "containers"
        },
        "annotations": {
          "summary": "Container memory usage high",
          "description": "Container {{ $labels.container_name }} memory usage is above 1GB"
        }
      },
      {
        "name": "ContainerDown",
        "description": "Alert when a container is not running",
        "expr": "absent(container_memory_usage_total{container_name!=\"\"}) == 1",
        "for": "2m",
        "severity": "critical",
        "labels": {
          "team": "infrastructure",
          "service": "containers"
        },
        "annotations": {
          "summary": "Container not detected",
          "description": "No container metrics received for more than 2 minutes"
        }
      }
    ]
  }
}